#!/bin/bash


DIST_DIR="dist"
MIN_SIZE_KB="100"

echo "🚑 Build $DIST_DIR output health check..."

dirExists() {
  if [[ ! -d "$1" ]]; then
    echo "❌ Error: Couldn't find the directory $1"

    if [[ "$1" != "$DIST_DIR" ]]; then
      echo "💡 Have you modified the distribution file architecture and forgot to update this checkup?"
    fi

    exit 1;
  fi
}

dirExists "$DIST_DIR"

for dir in cjs esm types; do
  full_path="$DIST_DIR/$dir"

  dirExists "$full_path"

  file_count=$(find "$full_path" -type f | wc -l)
  file_count=$(echo "$file_count" | xargs)

  if [[ "$file_count" -eq 0 ]]; then
    echo "❌ Error: The directory $full_path has $file_count files. Is this expected?"

    exit 1;
  fi

  dir_size=$(du -sk "$full_path" | cut -f1)

  if [[ "$dir_size" -lt "$MIN_SIZE_KB" ]]; then
    echo "❌ Error: The directory $full_path size is smaller than minimum expected size of $MIN_SIZE_KB KB"

    exit 1;
  fi
done

esm_files_importing_cjs=$(grep -rlE "(from|import) ['\"][^'\"]+/dist/cjs/" "$DIST_DIR/esm" --include='*.js')

if [[ -n "$esm_files_importing_cjs" ]]; then
  echo "❌ Error: The ESM build imports a dependency's CommonJS build, which breaks ESM-only module runners such as Vite SSR:"
  echo "$esm_files_importing_cjs"

  exit 1;
fi

cjs_files_requiring_esm=$(grep -rlE "require\(['\"][^'\"]+/dist/esm/" "$DIST_DIR/cjs" --include='*.cjs')

if [[ -n "$cjs_files_requiring_esm" ]]; then
  echo "❌ Error: The CommonJS build requires a dependency's ESM build, which breaks CommonJS consumers such as Jest:"
  echo "$cjs_files_requiring_esm"

  exit 1;
fi

echo "✅ Done! Build $DIST_DIR output health check completed."
exit 0
