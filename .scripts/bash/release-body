#!/bin/bash
#
# Compose the GitHub release notes from GitHub's generated notes and the release's changelog section.
# Stdout = release body, stderr = diagnostics.
# Usage: release-body <section-file> <generated-notes-file>
#   <section-file>          Body of the `## X.Y.Z` section, as release-changelog prints it. May be empty.
#   <generated-notes-file>  GitHub's generated notes: "## What's Changed", "## New Contributors" and
#                           the "**Full Changelog**" line. May be empty.
#
#   The body, in this order, with empty parts left out:
#     ## What's Changed     GitHub's list
#     ## ⚠️ Upgrade notes    Major changes, and entries that start with Breaking: (bold or not)
#     ## Good to know       The other entries
#     ## New Contributors   GitHub's list
#     **Full Changelog**    GitHub's compare link
#   Everywhere, `* ` bullets become `- `, and ` @user ` and pull request URLs become links, so the notes
#   mention nobody. Entries lose their `<sha>: ` prefix. Exit 1 when the body would be empty.
#
# Used by publish.yml. Runs on macOS bash 3.2 and Linux bash 5.

set -euo pipefail
export LC_ALL=C

if [[ $# -ne 2 ]]; then
  echo "❌ Error: Usage: release-body <section-file> <generated-notes-file>" >&2
  exit 1
fi

SECTION="$1"
GENERATED="$2"

for FILE in "$SECTION" "$GENERATED"; do
  if [[ ! -f "$FILE" ]]; then
    echo "❌ Error: file not found: $FILE" >&2
    exit 1
  fi
done

# Release bodies written in the GitHub UI come with CRLF line endings.
ENTRIES=$(mktemp)
NOTES=$(mktemp)
trap 'rm -f "$ENTRIES" "$NOTES"' EXIT
tr -d '\r' < "$SECTION" > "$ENTRIES"
tr -d '\r' < "$GENERATED" > "$NOTES"

# tagged_entries <section>: every line tagged U (upgrade notes) or G (good to know). An entry starts at
# `- ` and runs to the next entry or heading; headings and lines before the first entry are dropped.
tagged_entries() {
  awk -v hex='[0-9a-f]' '
    BEGIN { group = "G" }
    /^### / { group = /^### Major/ ? "U" : "G"; bucket = ""; next }
    /^- / {
      bucket = group
      sub("^- " hex hex hex hex hex hex hex hex "*: ", "- ")
      if ($0 ~ /^- (\*\*)?Breaking/) bucket = "U"
    }
    bucket != "" { print bucket "\t" $0 }
  ' "$1"
}
# pick <tag> <tagged lines>: the lines of one bucket, untagged, without leading blank lines.
pick() {
  printf '%s\n' "$2" | { grep "^$1"$'\t' || true; } | cut -f2- | sed '/./,$!d'
}
# block <generated> <heading>: the non-empty lines under `## <heading>`, up to the next `## ` heading
# or the Full Changelog line.
block() {
  awk -v heading="## $2" '
    /^## / || /^\*\*Full Changelog\*\*/ { on = ($0 == heading) }
    on && $0 != heading && NF { print }
  ' "$1"
}
# link: GitHub's `* ` bullets as `- `; ` @user ` and pull request URLs as Markdown links.
link() {
  sed -E \
    -e 's/^\* /- /' \
    -e 's|(https://github\.com/[^/ ]+/[^/ ]+/pull/([0-9]+))|[#\2](\1)|g' \
    -e 's| @([A-Za-z0-9-]+) | [@\1](https://github.com/\1) |g' \
    -e 's| @([A-Za-z0-9-]+)\[bot\] | [@\1[bot]](https://github.com/apps/\1) |g'
}
# part <heading> <content>: the part, unless the content is empty.
part() {
  if [[ -n "$2" ]]; then printf '%s\n\n%s\n\n' "$1" "$2"; fi
}

TAGGED=$(tagged_entries "$ENTRIES")
UPGRADE=$(pick U "$TAGGED" | link)
GOOD=$(pick G "$TAGGED" | link)
WHATS_CHANGED=$(block "$NOTES" "What's Changed" | link)
CONTRIBUTORS=$(block "$NOTES" "New Contributors" | link)
FULL_CHANGELOG=$(sed -n '/^\*\*Full Changelog\*\*/{p;q;}' "$NOTES")

BODY=$(
  part "## What's Changed" "$WHATS_CHANGED"
  part "## ⚠️ Upgrade notes" "$UPGRADE"
  part "## Good to know" "$GOOD"
  part "## New Contributors" "$CONTRIBUTORS"
  if [[ -n "$FULL_CHANGELOG" ]]; then printf '%s\n' "$FULL_CHANGELOG"; fi
)
if [[ -z "$BODY" ]]; then
  echo "❌ Error: nothing to write: $SECTION and $GENERATED are both empty" >&2
  exit 1
fi

printf '%s\n' "$BODY"
